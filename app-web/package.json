{
  "name": "app-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx dotenv-cli -e .env.develop -- next dev --turbopack",
    "build": "next build",
    "build:local": "npm run format && npm run lint && npx dotenv-cli -e .env.develop -- next build && npm run start:develop",
    "start": "next start",
    "start:develop": "npx dotenv-cli -e .env.develop -- next start",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.tsx\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.4.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@react-oauth/google": "^0.13.5",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "axios": "^1.18.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "js-cookie": "^3.0.8",
    "jwt-decode": "^4.0.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "react-icons": "^5.7.0",
    "react-toastify": "^11.1.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/crypto-js": "^4.2.2",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prettier": "3.9.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
